Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa HTTPS + non-www.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

    # Tolak akses file/folder internal Laravel.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.|artisan$|composer\.(?:json|lock)$|package(?:-lock)?\.json$|vite\.config\.js$|phpunit\.xml$|tailwind\.config\.js$|postcss\.config\.js$|README\.md$) - [F,L,NC]

    # Laravel public.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
